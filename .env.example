DATABASE_URL="postgresql://poker:poker@localhost:5432/poker_tournament"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Optional comma-separated extras; www/apex variants of NEXTAUTH_URL are added automatically
# CORS_ORIGINS="https://pokertableclub.com,https://www.pokertableclub.com"
GAME_SERVER_URL="http://localhost:3001"
GAME_SERVER_WS="ws://localhost:3001"
NEXT_PUBLIC_GAME_SERVER_WS="http://localhost:3001"
JWT_SECRET="change-me-game-server-jwt-secret"
INVITE_CODE="friends-only"
# Comma-separated extra admin emails. Always includes spnayar@gmail.com and info@pokertableclub.com.
ADMIN_EMAILS="spnayar@gmail.com,info@pokertableclub.com"
# Resend. Never commit a real key. If empty, login still works: non-prod prints the magic-link URL in the web server console.
RESEND_API_KEY=""
# Optional. If unset, the app defaults to Poker Night <noreply@mail.pokertableclub.com>. Reply-To is always info@pokertableclub.com.
EMAIL_FROM="Poker Night <noreply@mail.pokertableclub.com>"
# Optional. Magic-link lifetime in seconds (default 900 = 15 minutes)
# AUTH_EMAIL_MAX_AGE="900"
