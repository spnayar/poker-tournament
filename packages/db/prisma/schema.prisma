generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
}

enum AccountStatus {
  FREE
  PAID
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  displayName   String
  /// False until the player confirms a display name on profile. Existing accounts stay true.
  displayNameSet Boolean  @default(true)
  /// Legacy password logins only. New accounts have none.
  passwordHash  String?
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  role          UserRole       @default(PLAYER)
  /// Label only until billing exists. Not a payment record.
  accountStatus AccountStatus  @default(FREE)
  lastLoginAt   DateTime?
  loginCount    Int            @default(0)
  /// Preferred off-site settle-up methods ({ provider, contact }[]). Site never moves money.
  settleUpMethods Json         @default("[]")

  hostedTournaments Tournament[]       @relation("Host")
  tournamentPlayers TournamentPlayer[]
  gameResults       GameResult[]
  stats             UserStats?
  loginDays         UserLoginDay[]
}

/// One row per user per UTC day they successfully signed in (magic-link).
model UserLoginDay {
  userId String
  day    DateTime @db.Date
  count  Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

/// Site-wide counters keyed by UTC date. Hands only — nights/tournaments use existing tables.
model SiteDayStat {
  day   DateTime @id @db.Date
  hands Int      @default(0)
}

/// NextAuth Email provider one-time tokens (hashed). JWT sessions stay in cookies.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model UserStats {
  id               String @id @default(cuid())
  userId           String @unique
  tournamentsPlayed Int   @default(0)
  wins             Int    @default(0)
  itmCount         Int    @default(0)
  totalBuyInCents  Int    @default(0)
  totalPayoutCents Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TournamentStatus {
  LOBBY
  RUNNING
  FINISHED
}

enum GameStatus {
  RUNNING
  FINISHED
}

model Tournament {
  id             String           @id @default(cuid())
  hostUserId     String
  status         TournamentStatus @default(LOBBY)
  name           String
  buyInCents     Int
  startingChips  Int
  maxPlayers     Int              @default(9)
  payoutPercents Json @default("[70, 20, 10]")
  blindPreset    String           @default("gradual")
  blindPace      String           @default("gradual")
  blindLevelMinutes Int           @default(12)
  blindLevels    Json             @default("[]")
  inviteCode     String           @unique @default(cuid())
  createdAt      DateTime         @default(now())
  closedAt       DateTime?

  host    User               @relation("Host", fields: [hostUserId], references: [id])
  players TournamentPlayer[]
  games   Game[]
}

model TournamentPlayer {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  joinedAt     DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
}

model Game {
  id             String     @id @default(cuid())
  tournamentId   String
  gameNumber     Int
  status         GameStatus @default(RUNNING)
  prizePoolCents Int        @default(0)
  /// Hands dealt in this tournament (no cards stored).
  handsPlayed    Int        @default(0)
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?

  tournament Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  results    GameResult[]

  @@unique([tournamentId, gameNumber])
}

model GameResult {
  id             String @id @default(cuid())
  gameId         String
  userId         String
  finishPosition Int
  payoutCents    Int    @default(0)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([gameId, userId])
}
